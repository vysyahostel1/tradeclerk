# TradeClerk - Environment Variables
# Copy this file to .env and fill in the values

# Database
# Local: file:./db/custom.db
# Turso: libsql://your-db-name.your-region.turso.io
DATABASE_URL=file:./db/custom.db

# Turso Auth Token (required when using Turso)
DATABASE_AUTH_TOKEN=

# JWT Secret (IMPORTANT: change this to a strong random string in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Optional: Admin seed password
# ADMIN_PASSWORD=your_secure_password
