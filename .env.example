# TradeClerk - Environment Variables
# Copy this file to .env and fill in the values

# Database
# Local: file:./db/custom.db
# Turso: set TURSO_URL and TURSO_AUTH_TOKEN instead
DATABASE_URL=file:./db/custom.db

# Turso Database (for production / Cloudflare Workers)
# URL from Turso dashboard (e.g., libsql://your-db.region.turso.io)
TURSO_URL=

# Auth token from Turso dashboard
TURSO_AUTH_TOKEN=

# JWT Secret (IMPORTANT: change this to a strong random string in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this
